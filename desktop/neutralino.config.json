{
  "applicationId": "io.github.uknw4.codequest",
  "version": "1.1.0",
  "defaultMode": "window",
  "port": 52741,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": false,
  "tokenSecurity": "one-time",
  "logging": { "enabled": false, "writeToLogFile": false },
  "modes": {
    "window": {
      "title": "CodeQuest",
      "width": 1280,
      "height": 820,
      "minWidth": 420,
      "minHeight": 560,
      "center": true,
      "icon": "/resources/icons/icon-512.png",
      "enableInspector": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "CodeQuest",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "binaryVersion": "6.5.0"
  }
}
